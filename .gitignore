# Uff! Platform - Git Ignore Rules

# Environment and configuration files
config/database.php
.env
.env.local
.env.production

# Uploaded files and user content
uploads/*
!uploads/.gitkeep

# Cache and temporary files
cache/
tmp/
temp/
*.tmp
*.cache

# Logs
logs/
*.log
error_log

# Database files
*.sql.backup
*.db
*.sqlite

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# Node.js (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer (if using PHP dependencies)
vendor/
composer.lock

# Build and distribution files
dist/
build/
*.min.js
*.min.css

# Backup files
*.bak
*.backup
backup_*

# Security and sensitive files
private_key*
*.pem
*.key
*.crt

# PHP specific
*.php~
.phpunit.result.cache

# Archive files
*.zip
*.tar.gz
*.rar

# Documentation build files
docs/_build/

# Local configuration overrides
config.local.php
database.local.php